NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side ONLY. This bypasses RLS entirely — same power as the service
# key the old Streamlit app used directly. NEVER prefix with NEXT_PUBLIC_,
# never expose to the browser. Only used in app/api/admin/create-user to
# let owners create new accounts. Get it from Supabase → Project Settings
# → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# Server-side only — no NEXT_PUBLIC_ prefix, never sent to the browser.
# Get these from africastalking.com. Required for Customer Messaging "Send".
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
